# Copy this file to .env. Keep values unquoted and use only the password
# characters accepted by ./scripts/state-service.sh validate.
# The script rejects placeholders and passwords shorter than 24 characters.

# Major-version track for this local lab. Upgrade it separately from Terraform code.
POSTGRES_IMAGE=postgres:17-bookworm

# PostgreSQL administrator credential. Used only for service administration.
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Dedicated non-superuser role used by Terraform's pg backend.
TERRAFORM_DB_USER=terraform_backend_runtime
TERRAFORM_DB_PASSWORD=replace-with-a-different-long-random-runtime-password

# Fixed loopback port. Change it explicitly if 15432 is unavailable.
TERRAFORM_STATE_DB_PORT=15432
