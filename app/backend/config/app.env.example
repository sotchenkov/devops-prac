# Non-secret local defaults. Source or copy these values into your own runtime environment.
HTTP_ADDRESS=:8080
APP_ENVIRONMENT=local
LOG_LEVEL=info
STARTUP_DELAY=1s
SHUTDOWN_TIMEOUT=10s
METRICS_AUTH_ENABLED=false
# When metrics authentication is enabled, point this at a mounted secret file.
# METRICS_TOKEN_FILE=/run/secrets/metrics-auth/token
